node_modules/
.next/
out/
coverage/
dist/
build/
*.egg-info/
.eggs/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Editor & OS ---
.DS_Store
.idea/
.vscode/
*.swp
*.swo
Thumbs.db

# --- Log ---
*.log
logs/

# --- Upload sementara ---
uploads/
tmp/
