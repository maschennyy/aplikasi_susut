# Backend Flask yang dituju oleh Next.js rewrites.
# Development lokal:
FLASK_API_BASE_URL=http://127.0.0.1:5000

# Browser tetap mengakses backend melalui origin Next.js.
# Nilai default aplikasi sudah sama, tetapi dicantumkan agar konfigurasi jelas.
NEXT_PUBLIC_API_BASE_URL=/flask-api
NEXT_PUBLIC_FLASK_LOGIN_PATH=/flask-login
NEXT_PUBLIC_FLASK_LOGOUT_PATH=/flask-logout
NEXT_PUBLIC_CSRF_TOKEN_PATH=/flask-api/csrf-token
NEXT_PUBLIC_APP_LOGIN_PATH=/login
